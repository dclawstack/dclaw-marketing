# Backend
DATABASE_URL=postgresql+asyncpg://dclaw:dclaw@localhost:5432/dclaw_marketing
APP_ENV=dev
DEBUG=true

# AI
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Tenant secret encryption — used to seal per-org API keys (model
# providers, OAuth tokens) in the DB. MUST be a valid Fernet key
# (32 url-safe base64-encoded bytes). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_ENCRYPTION_MASTER_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8156
